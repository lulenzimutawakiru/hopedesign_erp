.prod-gen.env
env/
backups/

# Operator host-alert overrides (ALERT_EMAIL etc) - read by deploy/alert.sh only.
deploy/alert.env

# Cloudflare tunnel token - read only by deploy/docker-compose.cloudflared.yml.
deploy/cloudflared.env

# Postgres streaming-replication credentials (REPLICATION_PASSWORD) - read only by the
# replication/standby scripts in deploy/. Never commit.
deploy/replication.env

