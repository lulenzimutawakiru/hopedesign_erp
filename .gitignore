hv-*.json
hv-*.jsonl
hv-*.txt
/vercel-sync-env.cjs
/dba-probe.cjs
/prod-env-gen.cjs

# Runtime operational logs written by cron/deploy scripts on the server
logs/

# Cross-node failover settings + DNS API tokens - read only by
# deploy/failover-agent.sh and deploy/dns-failover.sh. Never commit.
deploy/failover.env