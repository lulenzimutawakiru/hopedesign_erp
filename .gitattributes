# Line-ending policy.
#
# This repo is deployed by exporting an archive (git archive) from a Windows
# checkout where core.autocrlf=true. Without this file that export rewrites
# LF to CRLF for every text file, which breaks anything executed by a POSIX
# shell inside a container - e.g. deploy/caddy-entrypoint.sh fails with
# `set: line 2: illegal option -` and the Caddy container crash-loops.
#
# Forcing eol=lf here keeps exports and checkouts byte-identical to the
# committed blobs regardless of the host platform.
* text=auto eol=lf

# Scripts executed by /bin/sh or node inside containers - LF is mandatory.
*.sh   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.md   text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf
.gitignore    text eol=lf

# Binary assets - never normalise.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.zip  binary
*.gz   binary