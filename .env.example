# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hopedesign
POSTGRES_PASSWORD=hopedesign_dev
POSTGRES_DB=hopedesign_erp
DATABASE_URL=postgres://hopedesign:hopedesign_dev@localhost:5432/hopedesign_erp

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
REFRESH_SECRET=change-me-too
DOC_SIGNING_SECRET=change-me-doc-signing-v1
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173
OTP_ISSUER=HopeDesignERP

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Object storage (local dev)
STORAGE_ROOT=./data/uploads

# Niimbot label printing (ream/carton QR authenticity labels)
# NIIMBOT_ENABLED=true when a bridge is running; the bridge itself reads the rest.
NIIMBOT_ENABLED=false
NIIMBOT_BRIDGE_URL=http://192.168.1.50:8188
NIIMBOT_MAC=
# Africa's Talking (the only SMS/WhatsApp delivery provider; used when AT_USERNAME and AT_API_KEY are set)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# AT-issued WhatsApp virtual number for the Chat API (e.g. +2567XXXXXXXX).
# When set, WhatsApp delivery is routed through Africa's Talking.
AT_WHATSAPP_NUMBER=

# Resend (the only email delivery provider; used when RESEND_API_KEY and RESEND_FROM_EMAIL are set).
# RESEND_FROM_EMAIL must be a verified sender in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@hopedesign.jorlentech.com
RESEND_FROM_NAME=HOPE DESIGN
# Svix signing secret for the Resend email.received webhook (whsec_...).
# Absent means the inbound mail endpoint refuses every delivery.
RESEND_WEBHOOK_SECRET=

# Meta WhatsApp Business Cloud API (the primary WhatsApp provider). Set
# WHATSAPP_ACCESS_TOKEN and WHATSAPP_PHONE_NUMBER_ID to enable outbound send and
# the inbound webhook; WHATSAPP_APP_SECRET authenticates the webhook, and
# WHATSAPP_VERIFY_TOKEN completes Meta's GET subscription handshake.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# WhatsApp sign-in codes (MFA-004). Optional; default to the email code values.
# MFA_WHATSAPP_CODE_TTL_MINUTES=10
# MFA_WHATSAPP_CODE_RESEND_SECONDS=60

# URA EFRIS fiscalization (the "tax control" service). The integration
# configuration lives in the database, but secrets are never stored there:
# efris_configurations keeps only env-var *names* (client_id_ref / credentials_ref)
# and the worker resolves the values at submit time. Run `npm run efris:onboard -w
# apps/api` to write the taxpayer + TEST configuration rows; it reads these vars.
#
# URA-issued identity + fiscal device credentials (required by the onboarding):
#   EFRIS_TIN          - taxpayer TIN (the real URA TIN, not the placeholder on
#                        the bootstrap company row).
#   EFRIS_LEGAL_NAME   - registered legal name.
#   EFRIS_DEVICE_NO    - fiscal device / TCU number (4-40 chars [A-Za-z0-9_-]).
#   EFRIS_PRIVATE_KEY  - device RSA private key (PEM). Single line: either base64
#                        of the PEM, or the PEM with literal \n escapes.
EFRIS_TENANT_ID=2
EFRIS_COMPANY_ID=2
EFRIS_BRANCH_ID=2
EFRIS_TIN=
EFRIS_LEGAL_NAME=
EFRIS_DEVICE_NO=
EFRIS_PRIVATE_KEY=
# Optional onboarding toggles.
# EFRIS_PROBE=true            # run the T101 sandbox proof right after onboarding
# EFRIS_FISCALIZE_ON_POST=true
# EFRIS_AUTO_SUBMIT=true
