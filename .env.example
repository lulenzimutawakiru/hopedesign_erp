# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hopedesign
POSTGRES_PASSWORD=hopedesign_dev
POSTGRES_DB=hopedesign_erp
DATABASE_URL=postgres://hopedesign:hopedesign_dev@localhost:5432/hopedesign_erp

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
REFRESH_SECRET=change-me-too
DOC_SIGNING_SECRET=change-me-doc-signing-v1
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173
OTP_ISSUER=HopeDesignERP

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Object storage (local dev)
STORAGE_ROOT=./data/uploads

# Niimbot label printing (ream/carton QR authenticity labels)
# NIIMBOT_ENABLED=true when a bridge is running; the bridge itself reads the rest.
NIIMBOT_ENABLED=false
NIIMBOT_BRIDGE_URL=http://192.168.1.50:8188
NIIMBOT_MAC=
# Bird (email / SMS / WhatsApp delivery)
# Put your real API key (bk_...) in .env (gitignored); never commit it.
BIRD_API_KEY=
BIRD_FROM_EMAIL=notifications@hopedesign.jorlentech.com
BIRD_FROM_NAME=HOPE DESIGN ERP
BIRD_SMS_FROM=
BIRD_WHATSAPP_FROM=

# Africa's Talking (SMS delivery; used when AT_USERNAME and AT_API_KEY are set)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# AT-issued WhatsApp virtual number for the Chat API (e.g. +2567XXXXXXXX).
# When set, WhatsApp delivery is routed through Africa's Talking instead of Bird.
AT_WHATSAPP_NUMBER=

# Resend (email delivery; used when RESEND_API_KEY and RESEND_FROM_EMAIL are set).
# RESEND_FROM_EMAIL must be a verified sender in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@hopedesign.jorlentech.com
RESEND_FROM_NAME=HOPE DESIGN ERP
