{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip zstd

	# Access logging. This site previously had no request log at all, which is why
	# a 16 h gap in Hikvision deliveries was invisible from the server side.
	# Hikvision terminals cap the webhook URL at 128 characters and cannot send
	# custom headers, so the device credential travels in the query string
	# (?serial=<serial>&key=<40 hex>); redact it here so an access log can never
	# become a key leak. Output is stdout, which the compose json-file driver
	# already rotates (x-logging: 10 MB x 3) - no new volume, no host path.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace key REDACTED
				}
			}
		}
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		-Server
	}

	@https protocol https
	header @https Strict-Transport-Security "max-age=15552000; includeSubDomains"

	request_body {
		max_size 25MB
	}

	@api path /api /api/*
	handle @api {
		# Hikvision terminals cap the webhook URL at 128 characters and cannot
		# send custom headers, so credentials must travel in the query string.
		# The canonical path plus ?serial=<44>&key=<48> exceeds that limit; this
		# alias keeps the device-facing URL short. Same handler, same auth.
		@hik path /api/hik
		rewrite @hik /api/integrations/hikvision/events
		# The ACTIVE API color is chosen by deploy/zero-downtime-deploy.sh and
		# deploy/stack-watchdog.sh. They rewrite active.caddy and atomically
		# `caddy reload`, so /api traffic always hits exactly one healthy color.
		import /etc/caddy/live/active.caddy
	}

	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# The SPA runs as web.deploy.replicas replicas (docker-compose.prod.yml:
		# deploy.replicas). Each replica is listed by its stable compose container
		# name on purpose: Caddy treats a single hostname upstream as ONE target, so
		# `reverse_proxy web:80` would pool keep-alive connections against whichever
		# A record Go resolved first and never spread load across the replicas.
		# Distinct upstreams give lb_policy least_conn something to balance, and let
		# the health checks eject only the replica that is actually failing.
		# Keep this list in sync with deploy.replicas; deploy/stack-watchdog.sh
		# reconciles the replica count.
		reverse_proxy hopedesign-erp-web-1:80 hopedesign-erp-web-2:80 {
			# Pool membership is node-local: deploy/caddy-live/webpeer.caddy (untracked)
			# carries the peer VPS as an extra upstream, reached only over the
			# WireGuard tunnel. The glob makes this import a no-op on a node without
			# that file, so one tracked Caddyfile stays correct on every node.
			import /etc/caddy/live/webpeer*.caddy
			lb_policy least_conn
			health_uri /
			health_interval 5s
			health_timeout 3s
			max_fails 2
			fail_duration 30s
			# A dead upstream is retried against a healthy one instead of being handed
			# to the visitor. Without this, a node that is GONE (host down or tunnel
			# down) refuses the dial, and reverse_proxy returns that error straight to
			# the browser: intermittent 502s for about one request in three, for as
			# long as it takes the active health check to eject the dead upstream.
			# The try window also covers a replica that is merely restarting.
			lb_try_duration 5s
			lb_try_interval 200ms
		}
	}
}

# Optional site for the availability monitor. deploy/caddy-entrypoint.sh writes
# this file at boot: a real site block when KUMA_DOMAIN is set, and a single
# comment when it is not. The target always exists, so the Caddyfile parses the
# same either way and this import is a no-op by default.
import /etc/caddy/live/uptime.caddy
# Internal frontend door for the OTHER node, and the reason a whole VPS can go
# away without the frontend blinking. Plain HTTP, no hostname, no ACME, no log
# of its own: the only thing that can reach it is the peer VPS over WireGuard,
# because the container port is published on the tunnel address only
# (deploy/docker-compose.primary-bridge.yml publishes 10.77.0.1:9103, and the
# peer's own overlay publishes 10.77.0.2:8080).
#
# The two nodes point at each other's copy of this block through their
# node-local `webpeer*.caddy` files, so each node's public pool ends up holding
# its own replicas PLUS the other machine's:
#
#   primary:  webpeer.caddy -> to 10.77.0.2:8080
#   peer:     webpeer.caddy -> to 10.77.0.1:9103
#
# Losing web-1 and web-2 on one node is then not a failover event at all - the
# surviving node's replicas were already healthy pool members, so Caddy simply
# keeps sending to them. There is no promotion step to miss and nothing to
# trigger. A request that arrives here is served by THIS node's replicas, so the
# mutual includes cost at most one hop and cannot loop.
:8080 {
	handle {
		reverse_proxy hopedesign-erp-web-1:80 hopedesign-erp-web-2:80 {
			# Deliberately NO webpeer*.caddy import here. Both nodes publish a
			# door that maps to this same container port (primary 10.77.0.1:9103,
			# peer 10.77.0.2:8080) and the two webpeer files point at each other.
			# Importing the peer here would have this door proxy into the other
			# node's door, which points straight back: a two-hop loop that no
			# health check can break. The door always answers with LOCAL
			# replicas; it is the public site block above that pools the peer.
			lb_policy least_conn
			health_uri /
			health_interval 5s
			health_timeout 3s
			max_fails 2
			fail_duration 30s
			# Same retry window as the public door, so a caller never sees a 502 while
			# one local replica is down or restarting: the request is simply re-sent
			# to the healthy sibling.
			lb_try_duration 5s
			lb_try_interval 200ms
		}
	}
}

# ---- Internal API door (added 2026-09-26) ----------------------------------
# The API sibling of the :8080 block above, and it exists for the same reason:
# to give the OTHER node a warm, healthy copy of this node's API to fall
# back on. deploy/caddy-live/peer.caddy on the peer points at this door
# (peer -> 10.77.0.1:9104), and this node's peer.caddy points at the peer's
# :8081, so each node's public API pool holds one local colour plus the
# other node's door.
#
# Why a door and not the peer's colours directly: an upstream address has to
# be resolvable from THIS node, and the peer's api-a/api-b are container
# names on the peer. The door is one stable WireGuard address that is
# always reachable as long as the tunnel is up.
#
# Deliberately NO peer*.caddy import here, for exactly the reason spelled
# out inside the :8080 block above: both nodes publish a door that maps to
# their own local colours, so importing the peer's door file here would have
# this door proxy into the other node's door, which points straight back -
# a two-hop loop no health check can break. The door answers with LOCAL
# colours only; it is each node's PUBLIC site block that pools the peer.
#
# Both local colours are listed so the door keeps answering while one colour
# is being recreated by a rollout, and options.caddy supplies lb_try_duration
# so a request is re-sent to the healthy sibling rather than returning a 502.
:8081 {
	handle {
		reverse_proxy api-a:4000 api-b:4000 {
			import /etc/caddy/live/options.caddy
		}
	}
}
