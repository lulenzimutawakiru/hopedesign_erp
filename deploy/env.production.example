# Copy to the repo root as `.env.production` (gitignored) and fill in.
#   cp deploy/env.production.example .env.production
#   node deploy/generate-env.mjs --domain hopedesign.jorlentech.com --email admin@hopedesign.jorlentech.com
#
# AccuWeb Linux VPS: point the domain's A record at the VPS public IP, then
# `docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build`.

# Public site. Use the hostname (Let's Encrypt). For HTTP-only first boot use :80
DOMAIN=hopedesign.jorlentech.com
ACME_EMAIL=admin@hopedesign.jorlentech.com

# Optional: publish the Uptime Kuma monitor at its own HTTPS hostname.
# Set this ONLY after an A record for the name points at this VPS - Caddy
# validates over HTTP-01, so it cannot issue a certificate for a name that does
# not resolve. While it is unset (the default) the monitor is reachable only by
# tunnelling to its loopback port, and nothing about it is public:
#   ssh -p 2978 -L 3001:127.0.0.1:3001 root@<vps>
# KUMA_DOMAIN=uptime.jorlentech.com
# Number of stateless API replicas behind the Caddy load balancer. 2 gives
# zero-downtime rolling deploys (one replica always serves while the other is
# replaced) and doubles request concurrency on the single-VPS deployment.
API_SCALE=2

# Must match the public URL browsers use (same host as Caddy).
WEB_PUBLIC_URL=https://hopedesign.jorlentech.com
API_PUBLIC_URL=https://hopedesign.jorlentech.com

NODE_ENV=production
PORT=4000
HOST=0.0.0.0
OTP_ISSUER=HopeDesignERP

# Owner / migration role (inside the compose network; not published).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hopedesign
POSTGRES_PASSWORD=change-me-owner-password-min-16
POSTGRES_DB=hopedesign_erp
POSTGRES_SSL=false
DATABASE_URL=postgres://hopedesign:change-me-owner-password-min-16@postgres:5432/hopedesign_erp

# Least-privilege runtime role (DB-001). Must NOT be `hopedesign` or `postgres`.
POSTGRES_APP_USER=hopedesign_app
POSTGRES_APP_PASSWORD=change-me-app-password-min-16

# Password for the BullMQ broker (the `redis` service in docker-compose.prod.yml).
# The broker itself is NOT published to the host, so this is defence in depth
# rather than the only control - but the job queue is the ERP's scheduler, and a
# container on the compose network should not be able to rewrite it.
#
# Only the password belongs here. REDIS_URL is composed from it in
# docker-compose.prod.yml, so the API, the worker and the broker cannot drift
# apart. Keep the value URL-safe (letters, digits, - and _): it is interpolated
# into `redis://:<password>@redis:6379/0`. `deploy/generate-env.mjs` emits a
# base64url value, which always qualifies.
REDIS_PASSWORD=change-me-redis-password-url-safe

# Signing keys — each >= 32 characters, unique, not the sample values.
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=8h
REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
DOC_SIGNING_SECRET=change-me-doc-signing-secret-at-least-32

STORAGE_ROOT=/data/uploads
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Set true ONCE on a fresh database to load demo/admin accounts, then set false.
# Default admin after seed: admin / ChangeMe!2026  — change immediately.
SEED_ON_BOOT=false

# Delivery providers: Resend is the only email provider; Africa's Talking is the only SMS provider.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@hopedesign.jorlentech.com
RESEND_FROM_NAME=HOPE DESIGN
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_WHATSAPP_NUMBER=
NIIMBOT_ENABLED=false
