# Copy to deploy/tunnel-ingress.env (chmod 600) and set at least TUNNEL_MODE.
#
# WHY THIS FILE EXISTS
# --------------------
# deploy/tunnel-ingress.sh owns the Cloudflare tunnel's ingress routes - the
# hostname -> origin rules that decide what the tunnel actually serves - from the
# tracked table in deploy/tunnel-routes.txt. To change those routes it needs two
# things that are a credential and a per-host choice, neither of which belongs in
# .env.production: that file is inherited by every service in
# docker-compose.prod.yml through `env_file:`, so anything added there changes
# the main stack's compose config hash and can recreate both API colours on the
# next `up -d`. deploy/cloudflared.env.example documents the same trap for
# ALERT_EMAIL.
#
# deploy/tunnel-ingress.env is gitignored and is read only by
# deploy/tunnel-ingress.sh, which sources it after deploy/failover.env.
#
# SET THIS ON BOTH NODES. Either node may be the one that reconciles the routes,
# and until the file exists there the mode reads as unset and the script falls
# through to its by-hand path - loudly, but without ever applying anything.
#
# WHERE TO GET THE CREDENTIAL
# ---------------------------
# Cloudflare dashboard -> My Profile -> API Tokens -> Create Token -> Custom
# token. It needs exactly one account-level permission:
#     Account  |  Cloudflare Tunnel  |  Edit
# (read is enough to inspect routes, but not to PUT them, so Edit is the one that
# matters). Scope it to the single account, not "All accounts".
#
# The account id is on the same page, or in any zone's Overview sidebar: the
# 32-character hex string. It is NOT the zone id.
#
# TO ROTATE: create the replacement token in the dashboard, update
# CLOUDFLARE_API_TOKEN here, confirm a run reports "in sync", then delete the old
# token.

# Which way this script is allowed to change the tunnel's routes.
#   api    PUT the rules to the Cloudflare API. Needs CLOUDFLARE_API_TOKEN and
#          CF_ACCOUNT_ID below. This is the only mode that changes a
#          remotely-managed tunnel's routes programmatically - the tunnel is
#          remotely managed, so this is the real one.
#   local  Render deploy/cloudflared/config.yml from deploy/tunnel-routes.txt and
#          an additive compose overlay that passes --config. Nothing is applied
#          unless TUNNEL_APPLY_LOCAL=1; the script prints the `up -d` to run.
#   unset  (leave the line commented) A known state, not a failure: the script
#          raises a CRITICAL alert and prints the exact dashboard rows to paste,
#          built from the same table it would have applied. Until then the tunnel
#          serves none of the names in deploy/tunnel-routes.txt.
TUNNEL_MODE=

# Required when TUNNEL_MODE=api. Needs Account: Cloudflare Tunnel:Edit.
CLOUDFLARE_API_TOKEN=

# Required when TUNNEL_MODE=api. The account id, not the zone id.
CF_ACCOUNT_ID=

# The zone the routes belong to. Defaults to jorlentech.com if unset. This is the
# same name deploy/failover.env uses for DNS failover, and this file wins because
# it is sourced after that one.
ZONE=jorlentech.com

# local mode only: set to 1 to run the rendered overlay's `up -d` as part of an
# apply, instead of only writing the files and printing the command. Left 0 so a
# reconcile cannot restart the ingress container by surprise.
TUNNEL_APPLY_LOCAL=0
