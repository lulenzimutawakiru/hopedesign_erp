# Copy to deploy/alert.env (chmod 600) and set the values for this host.
#
# WHY THIS FILE EXISTS
# --------------------
# deploy/alert.sh sends host/ops alerts (watchdog, backup catch-up, DR test,
# log tripwire) through the same Resend account the ERP uses. Those settings
# deliberately do NOT live in .env.production:
#
#   every compose service inherits `env_file: .env.production`, so editing that
#   file changes the compose config hash, and stack-watchdog.sh's
#   `up -d --no-deps api-a api-b` would then recreate BOTH API colours at once -
#   i.e. a self-inflicted outage from adding one email address.
#
# deploy/alert.sh sources this file with `set -a` before it reads any setting,
# and an already-exported variable wins over .env.production.

# Where host alerts are delivered.
#
# Keep this OUTSIDE the ERP domain. When it fell back to ACME_EMAIL
# (admin@hopedesign.jorlentech.com) every host alert was ingested back INTO the
# ERP as inbound mail on mailbox 10 (MAIL-ADMIN) - measured 2026-09-20/21 at
# 69 and 27 inbound messages/day, all of them alerts talking to themselves.
ALERT_EMAIL=ops@example.com

# Hard ceiling on host alert mail per UTC day. These alerts draw on the same
# Resend daily quota as sign-in codes and password mail; on 2026-09-20/21 that
# quota ran out and 41 alerts died with http=429, which would equally have
# killed a sign-in code issued in the same window. Default 40.
ALERT_DAILY_MAX=40

# Minimum seconds between two alerts with the same dedupe key. Default 3600.
#ALERT_THROTTLE_SECONDS=3600

# Set to 1 to bypass both the throttle and the daily cap (probes only).
#ALERT_FORCE=0